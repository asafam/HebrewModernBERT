#!/bin/bash
#SBATCH --job-name=hmb-lg-gate
#SBATCH --output=.slurm/logs/hmb-lg-gate_%j.out
#SBATCH --error=.slurm/logs/hmb-lg-gate_%j.err
#SBATCH --partition=p_b200_goldberg
#SBATCH --account=ug_goldberg
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=120GB
#SBATCH --time=01:00:00
#SBATCH --mail-type=FAIL

# LARGE phase-0 quality gate: convert a checkpoint to HF, then score whole-word MLM recovery
# against NeoDictaBERT and the base model on identical text (scripts/mlm_compare_vs_neodictabert.py).
# ALWAYS read the reference models FROM THIS JOB'S OWN OUTPUT -- never compare against numbers
# stored in docs/RETRIEVAL_EVAL.md or an older json. Verified 2026-08-11: the same NeoDictaBERT and
# base checkpoints scored 49.9/46.3 in the recorded run and 48.6/44.8 here, with identical n_words
# but different toks_per_word -- i.e. the sampled BeIR text changed underneath (the sibling repo's
# corpora are regenerated by other work). Both references moved by a similar margin, so within-run
# comparisons stay valid while cross-run ones do not. That is why --only always includes the
# references alongside the model under test.
#
# Runs on the 1-GPU Goldberg lane so it never competes with phase-0's 4-GPU p_b200_nlp allocation.
#
#   sbatch --export=ALL,BA=6000 .slurm/jobs/gate_large_phase0.slurm
set -e
mkdir -p .slurm/logs outputs/eval

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate bert-b200
cd /home/nlp/achimoa/workspace/HebrewModernBERT

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR="${SLURM_TMPDIR:-/tmp}/triton-gate-${SLURM_JOB_ID:-$$}"
mkdir -p "$TRITON_CACHE_DIR"
export HF_HUB_OFFLINE=1   # NeoDictaBERT is cached; don't let a hub hiccup stall the job

BA="${BA:?set BA to the checkpoint batch number, e.g. BA=6000}"
CKPT="checkpoints/large/modern-bert-large-phase-0-pretrain/ckpt/ep0-ba${BA}-rank0.pt"
NAME="HebrewModernBERT-large-p0-ba${BA}"
[ -f "$CKPT" ] || { echo "ERROR: $CKPT not found"; ls -1 checkpoints/large/modern-bert-large-phase-0-pretrain/ckpt/; exit 1; }

echo "############ STEP 1/2: convert $CKPT -> HF ############"
YAML=yamls/main/base_hebrew_large/flex-bert-rope-phase-0-pretrain.yaml \
CKPT="$CKPT" OUTPUT_NAME="$NAME" MAX_LENGTH=1024 \
  bash scripts/convert_to_hf_hebmodernbert.sh

echo "############ STEP 2/2: whole-word MLM vs NeoDictaBERT + base ############"
python scripts/mlm_compare_vs_neodictabert.py \
    --docs_per_dataset "${DOCS:-150}" \
    --masks_per_doc "${MASKS:-4}" \
    --extra-model "HMB large @ba${BA}=outputs/hf/${NAME}" \
    --only "NeoDictaBERT,phase-0 FINAL,large" \
    --out "outputs/eval/mlm_large_p0_ba${BA}.json"
echo "DONE -> outputs/eval/mlm_large_p0_ba${BA}.json"
